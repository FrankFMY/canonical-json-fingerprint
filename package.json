{
  "name": "@frankfmy/canonical-json-fingerprint",
  "version": "0.1.0",
  "description": "Strict canonical JSON serialization and deterministic SHA-256 fingerprints for TypeScript.",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "test": "bun test",
    "verify": "bun run check && bun test && bun run build"
  },
  "keywords": [
    "canonical-json",
    "deterministic",
    "fingerprint",
    "hash",
    "idempotency",
    "sha256",
    "typescript"
  ],
  "author": {
    "name": "Artem Prianishnikov",
    "email": "Pryanishnikovartem@gmail.com",
    "url": "https://frankfmy.com"
  },
  "license": "UNLICENSED",
  "homepage": "https://frankfmy.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrankFMY/canonical-json-fingerprint.git"
  },
  "bugs": {
    "url": "https://github.com/FrankFMY/canonical-json-fingerprint/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  }
}
